# ==========================================
# MedLens Root .gitignore
# Strictly keeps repository size below 10MB
# ==========================================

# 1. Environment variables (Secrets & API Keys - NEVER COMMIT)
.env
.env.*
.env.local
.env.development
.env.test
.env.production
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# 2. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# 3. Build & Production outputs
dist/
build/
backend/dist/
frontend/dist/
backend/build/
frontend/build/

# 4. Uploaded Medical Reports, Documents & Media
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
*.pdf
*.csv
*.tsv

# 5. Large Model Weights & Generated AI Files
*.pt
*.pth
*.onnx
*.h5
*.hdf5
*.pb
*.tflite
*.bin
*.pkl
*.pickle
*.safetensors
*.weights

# 6. Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. Temporary & Cache Files
.cache/
.temp/
tmp/
temp/
scratch/
*.tmp
*.bak
*.swp
*.swo

# 8. System & IDE / Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace